<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/cFondo"
    android:orientation="vertical">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/titulo"
                android:textColor="?attr/cTexto"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/sw_oscuro"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/modo_oscuro"
                android:textColor="?attr/cTexto"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/subtitulo"
            android:textColor="?attr/cTextoSuave"
            android:textSize="13sp" />

        <!-- ENTRADAS: MATERIAL -->
        <TextView style="@style/Seccion" android:text="@string/sec_material" />

        <TextView style="@style/Etiqueta" android:text="@string/lbl_precio_kg" />
        <EditText
            android:id="@+id/et_precio_kg"
            style="@style/Campo"
            android:hint="@string/hint_precio_kg"
            android:inputType="numberDecimal" />

        <TextView style="@style/Etiqueta" android:text="@string/lbl_gramos" />
        <EditText
            android:id="@+id/et_gramos"
            style="@style/Campo"
            android:hint="@string/hint_gramos"
            android:inputType="numberDecimal" />

        <TextView style="@style/Etiqueta" android:text="@string/lbl_piezas" />
        <EditText
            android:id="@+id/et_piezas"
            style="@style/Campo"
            android:hint="@string/hint_piezas"
            android:inputType="number" />

        <!-- ENTRADAS: TIEMPO -->
        <TextView style="@style/Seccion" android:text="@string/sec_tiempo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/Etiqueta" android:text="@string/lbl_horas" />
                <EditText
                    android:id="@+id/et_horas"
                    style="@style/Campo"
                    android:hint="@string/hint_horas"
                    android:inputType="numberDecimal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/Etiqueta" android:text="@string/lbl_minutos" />
                <EditText
                    android:id="@+id/et_minutos"
                    style="@style/Campo"
                    android:hint="@string/hint_minutos"
                    android:inputType="numberDecimal" />
            </LinearLayout>
        </LinearLayout>

        <!-- ENTRADAS: ELECTRICIDAD -->
        <TextView style="@style/Seccion" android:text="@string/sec_electricidad" />

        <!-- Consumo: menú de materiales (watts promedio de la A1 con cada material) -->
        <TextView style="@style/Etiqueta" android:text="@string/lbl_material_menu" />
        <Spinner
            android:id="@+id/sp_material"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:prompt="@string/prompt_material"
            android:spinnerMode="dialog" />
        <TextView
            android:id="@+id/tv_material_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/material_info_ninguno"
            android:textColor="?attr/cTextoSuave"
            android:textSize="12sp" />

        <!-- Solo con la opción "Otro" -->
        <LinearLayout
            android:id="@+id/ll_watts_otro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView style="@style/Etiqueta" android:text="@string/lbl_watts" />
            <EditText
                android:id="@+id/et_watts"
                style="@style/Campo"
                android:hint="@string/hint_watts"
                android:inputType="numberDecimal" />
        </LinearLayout>

        <!-- Precio del kWh: sale de la tabla por región -->
        <TextView style="@style/Etiqueta" android:layout_marginTop="18dp" android:text="@string/lbl_region" />
        <Spinner
            android:id="@+id/sp_region"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:prompt="@string/prompt_region"
            android:spinnerMode="dialog" />

        <Button
            android:id="@+id/btn_detectar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="2dp"
            android:text="@string/btn_detectar" />

        <TextView
            android:id="@+id/tv_region_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/region_info_inicial"
            android:textColor="?attr/cTexto"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_region_ref"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/region_ref_ninguna"
            android:textColor="?attr/cTextoSuave"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_tabla"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:text="@string/btn_ver_tabla" />

        <!-- Tabla de precios por región (se llena desde el código) -->
        <LinearLayout
            android:id="@+id/ll_tabla"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/cTarjeta"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone" />

        <!-- Solo si la región no tiene precio en la tabla, o con "Otra tarifa" -->
        <LinearLayout
            android:id="@+id/ll_kwh_manual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView style="@style/Etiqueta" android:layout_marginTop="14dp" android:text="@string/lbl_precio_kwh_manual" />
            <EditText
                android:id="@+id/et_precio_kwh"
                style="@style/Campo"
                android:hint="@string/hint_precio_kwh"
                android:inputType="numberDecimal" />

            <TextView style="@style/Subtitulo" android:text="@string/sub_boleta" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Etiqueta" android:text="@string/lbl_boleta_monto" />
                    <EditText
                        android:id="@+id/et_boleta_monto"
                        style="@style/Campo"
                        android:hint="@string/hint_boleta_monto"
                        android:inputType="numberDecimal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Etiqueta" android:text="@string/lbl_boleta_kwh" />
                    <EditText
                        android:id="@+id/et_boleta_kwh"
                        style="@style/Campo"
                        android:hint="@string/hint_boleta_kwh"
                        android:inputType="numberDecimal" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/FilaSugerido">
                <TextView
                    android:id="@+id/tv_boleta_resultado"
                    style="@style/TextoSugerido"
                    android:text="@string/boleta_ayuda" />
                <Button
                    android:id="@+id/btn_usar_boleta"
                    style="@style/BotonUsar" />
            </LinearLayout>
        </LinearLayout>

        <!-- ENTRADAS: EXTRAS OPCIONALES -->
        <TextView style="@style/Seccion" android:text="@string/sec_extras" />

        <TextView style="@style/Etiqueta" android:text="@string/lbl_horas_trabajo" />
        <EditText
            android:id="@+id/et_horas_trabajo"
            style="@style/Campo"
            android:hint="@string/hint_horas_trabajo"
            android:inputType="numberDecimal" />

        <TextView style="@style/Etiqueta" android:text="@string/lbl_costo_hora_trabajo" />
        <EditText
            android:id="@+id/et_costo_hora_trabajo"
            style="@style/Campo"
            android:hint="@string/hint_costo_hora_trabajo"
            android:inputType="numberDecimal" />

        <TextView style="@style/Etiqueta" android:text="@string/lbl_merma" />
        <EditText
            android:id="@+id/et_merma"
            style="@style/Campo"
            android:hint="@string/hint_merma"
            android:inputType="numberDecimal" />

        <TextView style="@style/Etiqueta" android:text="@string/lbl_otros" />
        <EditText
            android:id="@+id/et_otros"
            style="@style/Campo"
            android:hint="@string/hint_otros"
            android:inputType="numberDecimal" />

        <TextView style="@style/Etiqueta" android:text="@string/lbl_margen" />
        <EditText
            android:id="@+id/et_margen"
            style="@style/Campo"
            android:hint="@string/hint_margen"
            android:imeOptions="actionDone"
            android:inputType="numberDecimal" />

        <CheckBox
            android:id="@+id/cb_iva"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/cb_iva"
            android:textColor="?attr/cTexto"
            android:textSize="14sp" />

        <!-- BOTONES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_calcular"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/btn_calcular"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_limpiar"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/btn_limpiar" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/status_inicial"
            android:textColor="?attr/cTextoSuave"
            android:textSize="14sp" />

        <!-- RESULTADOS -->
        <TextView style="@style/Seccion" android:text="@string/sec_resultados" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/cTarjeta"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout style="@style/FilaResultado">
                <TextView style="@style/ResultadoEtiqueta" android:text="@string/res_material" />
                <TextView
                    android:id="@+id/tv_material"
                    style="@style/ResultadoValor"
                    android:text="@string/vacio" />
            </LinearLayout>

            <LinearLayout style="@style/FilaResultado">
                <TextView style="@style/ResultadoEtiqueta" android:text="@string/res_electricidad" />
                <TextView
                    android:id="@+id/tv_electricidad"
                    style="@style/ResultadoValor"
                    android:text="@string/vacio" />
            </LinearLayout>

            <LinearLayout style="@style/FilaResultado">
                <TextView style="@style/ResultadoEtiqueta" android:text="@string/res_depreciacion" />
                <TextView
                    android:id="@+id/tv_depreciacion"
                    style="@style/ResultadoValor"
                    android:text="@string/vacio" />
            </LinearLayout>

            <LinearLayout style="@style/FilaResultado">
                <TextView style="@style/ResultadoEtiqueta" android:text="@string/res_mantenimiento" />
                <TextView
                    android:id="@+id/tv_mantenimiento"
                    style="@style/ResultadoValor"
                    android:text="@string/vacio" />
            </LinearLayout>

            <LinearLayout style="@style/FilaResultado">
                <TextView style="@style/ResultadoEtiqueta" android:text="@string/res_mano_obra" />
                <TextView
                    android:id="@+id/tv_mano_obra"
                    style="@style/ResultadoValor"
                    android:text="@string/vacio" />
            </LinearLayout>

            <LinearLayout style="@style/FilaResultado">
                <TextView style="@style/ResultadoEtiqueta" android:text="@string/res_merma" />
                <TextView
                    android:id="@+id/tv_merma"
                    style="@style/ResultadoValor"
                    android:text="@string/vacio" />
            </LinearLayout>

            <LinearLayout style="@style/FilaResultado">
                <TextView style="@style/ResultadoEtiqueta" android:text="@string/res_otros" />
                <TextView
                    android:id="@+id/tv_otros"
                    style="@style/ResultadoValor"
                    android:text="@string/vacio" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="?attr/cLinea" />

            <LinearLayout style="@style/FilaResultado">
                <TextView
                    style="@style/ResultadoEtiqueta"
                    android:text="@string/res_total"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_total"
                    style="@style/ResultadoValor"
                    android:text="@string/vacio"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout style="@style/FilaResultado">
                <TextView
                    style="@style/ResultadoEtiqueta"
                    android:text="@string/res_unitario"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_unitario"
                    style="@style/ResultadoValor"
                    android:text="@string/vacio"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout style="@style/FilaResultado" android:layout_marginTop="6dp">
                <TextView style="@style/ResultadoEtiqueta" android:text="@string/res_por_gramo" />
                <TextView
                    android:id="@+id/tv_por_gramo"
                    style="@style/ResultadoValor"
                    android:text="@string/vacio" />
            </LinearLayout>

            <LinearLayout style="@style/FilaResultado">
                <TextView style="@style/ResultadoEtiqueta" android:text="@string/res_por_hora" />
                <TextView
                    android:id="@+id/tv_por_hora"
                    style="@style/ResultadoValor"
                    android:text="@string/vacio" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_calculado_con"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="?attr/cTexto"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_cuadra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?attr/cAcento"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_fijos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="?attr/cTextoSuave"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- PRECIO DE VENTA (solo si se indica margen) -->
        <TextView style="@style/Seccion" android:text="@string/sec_venta" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/cTarjeta"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout style="@style/FilaResultado">
                <TextView style="@style/ResultadoEtiqueta" android:text="@string/res_precio_venta" />
                <TextView
                    android:id="@+id/tv_precio_venta"
                    style="@style/ResultadoValor"
                    android:text="@string/vacio" />
            </LinearLayout>

            <LinearLayout style="@style/FilaResultado">
                <TextView style="@style/ResultadoEtiqueta" android:text="@string/res_precio_iva" />
                <TextView
                    android:id="@+id/tv_precio_iva"
                    style="@style/ResultadoValor"
                    android:text="@string/vacio" />
            </LinearLayout>

            <LinearLayout style="@style/FilaResultado">
                <TextView style="@style/ResultadoEtiqueta" android:text="@string/res_ganancia" />
                <TextView
                    android:id="@+id/tv_ganancia"
                    style="@style/ResultadoValor"
                    android:text="@string/vacio" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btn_compartir"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:enabled="false"
            android:text="@string/btn_compartir" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:text="@string/nota_formato"
            android:textColor="?attr/cTextoSuave"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>

    <!-- Barra fija: el total siempre a la vista mientras se editan los datos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/cTarjeta"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_barra_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/cTexto"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_barra_detalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/cTextoSuave"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_barra_hora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/cAcento"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
