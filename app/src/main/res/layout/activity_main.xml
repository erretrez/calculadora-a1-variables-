<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo"
            android:textColor="@color/texto"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/subtitulo"
            android:textColor="@color/texto_suave"
            android:textSize="13sp" />

        <!-- ENTRADAS: MATERIAL -->
        <TextView style="@style/Seccion" android:text="@string/sec_material" />

        <TextView style="@style/Etiqueta" android:text="@string/lbl_precio_kg" />
        <EditText
            android:id="@+id/et_precio_kg"
            style="@style/Campo"
            android:hint="@string/hint_precio_kg"
            android:inputType="numberDecimal" />

        <TextView style="@style/Etiqueta" android:text="@string/lbl_gramos" />
        <EditText
            android:id="@+id/et_gramos"
            style="@style/Campo"
            android:hint="@string/hint_gramos"
            android:inputType="numberDecimal" />

        <TextView style="@style/Etiqueta" android:text="@string/lbl_piezas" />
        <EditText
            android:id="@+id/et_piezas"
            style="@style/Campo"
            android:hint="@string/hint_piezas"
            android:inputType="number" />

        <!-- ENTRADAS: TIEMPO -->
        <TextView style="@style/Seccion" android:text="@string/sec_tiempo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/Etiqueta" android:text="@string/lbl_horas" />
                <EditText
                    android:id="@+id/et_horas"
                    style="@style/Campo"
                    android:hint="@string/hint_horas"
                    android:inputType="numberDecimal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/Etiqueta" android:text="@string/lbl_minutos" />
                <EditText
                    android:id="@+id/et_minutos"
                    style="@style/Campo"
                    android:hint="@string/hint_minutos"
                    android:inputType="numberDecimal" />
            </LinearLayout>
        </LinearLayout>

        <!-- ENTRADAS: ELECTRICIDAD -->
        <TextView style="@style/Seccion" android:text="@string/sec_electricidad" />

        <!-- Consumo de la impresora + referencias de la Bambu Lab A1 Combo -->
        <TextView style="@style/Etiqueta" android:text="@string/lbl_watts" />
        <EditText
            android:id="@+id/et_watts"
            style="@style/Campo"
            android:hint="@string/hint_watts"
            android:inputType="numberDecimal" />
        <LinearLayout style="@style/FilaSugerido">
            <TextView
                android:id="@+id/tv_watts_estandar"
                style="@style/TextoSugerido" />
            <Button
                android:id="@+id/btn_usar_watts_estandar"
                style="@style/BotonUsar" />
        </LinearLayout>
        <LinearLayout style="@style/FilaSugerido">
            <TextView
                android:id="@+id/tv_watts_alto"
                style="@style/TextoSugerido" />
            <Button
                android:id="@+id/btn_usar_watts_alto"
                style="@style/BotonUsar" />
        </LinearLayout>
        <TextView
            android:id="@+id/tv_watts_fuente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/watts_fuente"
            android:textColor="@color/texto_suave"
            android:textSize="11sp" />

        <!-- Precio del kWh (un solo campo) y sus ayudas -->
        <TextView style="@style/Etiqueta" android:layout_marginTop="18dp" android:text="@string/lbl_precio_kwh" />
        <EditText
            android:id="@+id/et_precio_kwh"
            style="@style/Campo"
            android:hint="@string/hint_precio_kwh"
            android:inputType="numberDecimal" />

        <Spinner
            android:id="@+id/sp_region"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/btn_detectar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="2dp"
            android:text="@string/btn_detectar" />

        <TextView
            android:id="@+id/tv_region_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/region_info_inicial"
            android:textColor="@color/texto"
            android:textSize="13sp" />

        <LinearLayout style="@style/FilaSugerido">
            <TextView
                android:id="@+id/tv_region_ref"
                style="@style/TextoSugerido"
                android:text="@string/region_ref_ninguna" />
            <Button
                android:id="@+id/btn_usar_region"
                style="@style/BotonUsar" />
        </LinearLayout>

        <TextView style="@style/Subtitulo" android:text="@string/sub_boleta" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/Etiqueta" android:text="@string/lbl_boleta_monto" />
                <EditText
                    android:id="@+id/et_boleta_monto"
                    style="@style/Campo"
                    android:hint="@string/hint_boleta_monto"
                    android:inputType="numberDecimal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/Etiqueta" android:text="@string/lbl_boleta_kwh" />
                <EditText
                    android:id="@+id/et_boleta_kwh"
                    style="@style/Campo"
                    android:hint="@string/hint_boleta_kwh"
                    android:inputType="numberDecimal" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/FilaSugerido">
            <TextView
                android:id="@+id/tv_boleta_resultado"
                style="@style/TextoSugerido"
                android:text="@string/boleta_ayuda" />
            <Button
                android:id="@+id/btn_usar_boleta"
                style="@style/BotonUsar" />
        </LinearLayout>

        <!-- Tarifa guardada: se conserva al cerrar la app, solo si el usuario toca GUARDAR -->
        <LinearLayout style="@style/FilaSugerido" android:layout_marginTop="14dp">
            <TextView
                android:id="@+id/tv_tarifa_guardada"
                style="@style/TextoSugerido"
                android:text="@string/tarifa_vacia"
                android:textColor="@color/texto" />
            <Button
                android:id="@+id/btn_guardar_tarifa"
                style="@style/BotonUsar"
                android:contentDescription="@string/btn_guardar"
                android:text="@string/btn_guardar" />
            <Button
                android:id="@+id/btn_usar_tarifa"
                style="@style/BotonUsar"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- ENTRADAS: EXTRAS OPCIONALES -->
        <TextView style="@style/Seccion" android:text="@string/sec_extras" />

        <TextView style="@style/Etiqueta" android:text="@string/lbl_horas_trabajo" />
        <EditText
            android:id="@+id/et_horas_trabajo"
            style="@style/Campo"
            android:hint="@string/hint_horas_trabajo"
            android:inputType="numberDecimal" />

        <TextView style="@style/Etiqueta" android:text="@string/lbl_costo_hora_trabajo" />
        <EditText
            android:id="@+id/et_costo_hora_trabajo"
            style="@style/Campo"
            android:hint="@string/hint_costo_hora_trabajo"
            android:inputType="numberDecimal" />

        <TextView style="@style/Etiqueta" android:text="@string/lbl_merma" />
        <EditText
            android:id="@+id/et_merma"
            style="@style/Campo"
            android:hint="@string/hint_merma"
            android:inputType="numberDecimal" />

        <TextView style="@style/Etiqueta" android:text="@string/lbl_margen" />
        <EditText
            android:id="@+id/et_margen"
            style="@style/Campo"
            android:hint="@string/hint_margen"
            android:imeOptions="actionDone"
            android:inputType="numberDecimal" />

        <CheckBox
            android:id="@+id/cb_iva"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/cb_iva"
            android:textColor="@color/texto"
            android:textSize="14sp" />

        <!-- BOTONES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_calcular"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/btn_calcular"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_limpiar"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/btn_limpiar" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/status_inicial"
            android:textColor="@color/texto_suave"
            android:textSize="14sp" />

        <!-- RESULTADOS -->
        <TextView style="@style/Seccion" android:text="@string/sec_resultados" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/tarjeta"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout style="@style/FilaResultado">
                <TextView style="@style/ResultadoEtiqueta" android:text="@string/res_material" />
                <TextView
                    android:id="@+id/tv_material"
                    style="@style/ResultadoValor"
                    android:text="@string/vacio" />
            </LinearLayout>

            <LinearLayout style="@style/FilaResultado">
                <TextView style="@style/ResultadoEtiqueta" android:text="@string/res_electricidad" />
                <TextView
                    android:id="@+id/tv_electricidad"
                    style="@style/ResultadoValor"
                    android:text="@string/vacio" />
            </LinearLayout>

            <LinearLayout style="@style/FilaResultado">
                <TextView style="@style/ResultadoEtiqueta" android:text="@string/res_depreciacion" />
                <TextView
                    android:id="@+id/tv_depreciacion"
                    style="@style/ResultadoValor"
                    android:text="@string/vacio" />
            </LinearLayout>

            <LinearLayout style="@style/FilaResultado">
                <TextView style="@style/ResultadoEtiqueta" android:text="@string/res_mantenimiento" />
                <TextView
                    android:id="@+id/tv_mantenimiento"
                    style="@style/ResultadoValor"
                    android:text="@string/vacio" />
            </LinearLayout>

            <LinearLayout style="@style/FilaResultado">
                <TextView style="@style/ResultadoEtiqueta" android:text="@string/res_mano_obra" />
                <TextView
                    android:id="@+id/tv_mano_obra"
                    style="@style/ResultadoValor"
                    android:text="@string/vacio" />
            </LinearLayout>

            <LinearLayout style="@style/FilaResultado">
                <TextView style="@style/ResultadoEtiqueta" android:text="@string/res_merma" />
                <TextView
                    android:id="@+id/tv_merma"
                    style="@style/ResultadoValor"
                    android:text="@string/vacio" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="@color/linea" />

            <LinearLayout style="@style/FilaResultado">
                <TextView
                    style="@style/ResultadoEtiqueta"
                    android:text="@string/res_total"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_total"
                    style="@style/ResultadoValor"
                    android:text="@string/vacio"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout style="@style/FilaResultado">
                <TextView
                    style="@style/ResultadoEtiqueta"
                    android:text="@string/res_unitario"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_unitario"
                    style="@style/ResultadoValor"
                    android:text="@string/vacio"
                    android:textSize="20sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_fijos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/texto_suave"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- PRECIO DE VENTA (solo si se indica margen) -->
        <TextView style="@style/Seccion" android:text="@string/sec_venta" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/tarjeta"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout style="@style/FilaResultado">
                <TextView style="@style/ResultadoEtiqueta" android:text="@string/res_precio_venta" />
                <TextView
                    android:id="@+id/tv_precio_venta"
                    style="@style/ResultadoValor"
                    android:text="@string/vacio" />
            </LinearLayout>

            <LinearLayout style="@style/FilaResultado">
                <TextView style="@style/ResultadoEtiqueta" android:text="@string/res_precio_iva" />
                <TextView
                    android:id="@+id/tv_precio_iva"
                    style="@style/ResultadoValor"
                    android:text="@string/vacio" />
            </LinearLayout>

            <LinearLayout style="@style/FilaResultado">
                <TextView style="@style/ResultadoEtiqueta" android:text="@string/res_ganancia" />
                <TextView
                    android:id="@+id/tv_ganancia"
                    style="@style/ResultadoValor"
                    android:text="@string/vacio" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:text="@string/nota_formato"
            android:textColor="@color/texto_suave"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
