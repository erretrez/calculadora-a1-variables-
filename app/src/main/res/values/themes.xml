<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema que usa Android antes de que la app elija entre claro y oscuro (ver values-night). -->
    <style name="AppTheme" parent="TemaClaro" />

    <style name="TemaClaro" parent="android:Theme.Material.Light.NoActionBar">
        <item name="cFondo">@color/fondo</item>
        <item name="cTarjeta">@color/tarjeta</item>
        <item name="cTexto">@color/texto</item>
        <item name="cTextoSuave">@color/texto_suave</item>
        <item name="cAcento">@color/acento</item>
        <item name="cLinea">@color/linea</item>
        <item name="cError">@color/error</item>
        <item name="cCampo">@color/campo</item>
        <item name="cCampoLleno">@color/campo_lleno</item>
        <item name="cBordeLleno">@color/borde_lleno</item>
        <item name="android:colorAccent">@color/acento</item>
        <item name="android:colorPrimary">@color/acento</item>
        <item name="android:statusBarColor">@color/fondo</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/fondo</item>
    </style>

    <style name="TemaOscuro" parent="android:Theme.Material.NoActionBar">
        <item name="cFondo">@color/fondo_oscuro</item>
        <item name="cTarjeta">@color/tarjeta_oscuro</item>
        <item name="cTexto">@color/texto_oscuro</item>
        <item name="cTextoSuave">@color/texto_suave_oscuro</item>
        <item name="cAcento">@color/acento_oscuro</item>
        <item name="cLinea">@color/linea_oscuro</item>
        <item name="cError">@color/error_oscuro</item>
        <item name="cCampo">@color/campo_oscuro</item>
        <item name="cCampoLleno">@color/campo_lleno_oscuro</item>
        <item name="cBordeLleno">@color/borde_lleno_oscuro</item>
        <item name="android:colorAccent">@color/acento_oscuro</item>
        <item name="android:colorPrimary">@color/acento_oscuro</item>
        <item name="android:statusBarColor">@color/fondo_oscuro</item>
        <item name="android:navigationBarColor">@color/fondo_oscuro</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/fondo_oscuro</item>
    </style>

    <style name="Seccion">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:textColor">?attr/cAcento</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Subtitulo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:textColor">?attr/cTexto</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Etiqueta">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textColor">?attr/cTexto</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Campo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">@drawable/campo_fondo</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:imeOptions">actionNext</item>
        <item name="android:maxLines">1</item>
        <item name="android:selectAllOnFocus">true</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">?attr/cTexto</item>
        <item name="android:textColorHint">?attr/cTextoSuave</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="FilaSugerido">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="TextoSugerido">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">?attr/cTextoSuave</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- focusable=false: el botón no interrumpe la navegación entre campos con TAB. -->
    <style name="BotonUsar">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:focusable">false</item>
        <item name="android:text">@string/btn_usar</item>
        <item name="android:contentDescription">@string/desc_usar</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="FilaResultado">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="ResultadoEtiqueta">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">?attr/cTexto</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="ResultadoValor">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">end</item>
        <item name="android:textColor">?attr/cTexto</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
